<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RVData2 Editor — RPG Maker VX Ace TL Tool</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root {
            --bg: #070b09;
            --surface: #0f1613;
            --surface2: #162019;
            --border: #1f332a;
            --border-hi: #2a4a3a;
            --text: #cde0d6;
            --text-dim: #5e8070;
            --accent: #00e896;
            --accent-dim: rgba(0,232,150,0.12);
            --accent-glow: rgba(0,232,150,0.25);
            --str-color: #ffd166;
            --num-color: #6ec6ff;
            --bool-color: #ff6b9d;
            --nil-color: #666;
            --sym-color: #a78bfa;
            --obj-color: #f97316;
            --mod-color: #38bdf8;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Space Grotesk', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: var(--surface); }
        ::-webkit-scrollbar-thumb { background: var(--border-hi); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-dim); }

        #uploadZone {
            border: 2px dashed var(--border);
            border-radius: 16px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        #uploadZone::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, var(--accent-dim), transparent 70%);
            opacity: 0;
            transition: opacity 0.3s;
        }
        #uploadZone:hover, #uploadZone.dragover {
            border-color: var(--accent);
            background: var(--surface);
        }
        #uploadZone:hover::before, #uploadZone.dragover::before { opacity: 1; }
        #uploadZone.dragover { transform: scale(1.01); }

        .tree-node { position: relative; }
        .node-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px;
            border-radius: 6px;
            cursor: default;
            transition: background 0.15s;
            min-height: 34px;
        }
        .node-header:hover { background: var(--surface2); }
        .node-header.has-children { cursor: pointer; }
        .toggle-icon {
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: var(--text-dim);
            transition: transform 0.2s;
            flex-shrink: 0;
        }
        .toggle-icon.collapsed { transform: rotate(-90deg); }
        .node-key {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
        }
        .node-children {
            padding-left: 20px;
            border-left: 1px solid var(--border);
            margin-left: 16px;
            display: none;
        }
        .node-children.expanded {
            display: block;
            animation: fadeSlide 0.2s ease;
        }
        @keyframes fadeSlide {
            from { opacity: 0; transform: translateY(-3px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .tbadge {
            font-size: 10px;
            font-family: 'JetBrains Mono', monospace;
            padding: 1px 6px;
            border-radius: 4px;
            font-weight: 500;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .tbadge-str { background: rgba(255,209,102,0.15); color: var(--str-color); }
        .tbadge-int { background: rgba(110,198,255,0.12); color: var(--num-color); }
        .tbadge-float { background: rgba(110,198,255,0.12); color: var(--num-color); }
        .tbadge-bool { background: rgba(255,107,157,0.12); color: var(--bool-color); }
        .tbadge-nil { background: rgba(102,102,102,0.15); color: var(--nil-color); }
        .tbadge-sym { background: rgba(167,139,250,0.12); color: var(--sym-color); }
        .tbadge-obj { background: rgba(249,115,22,0.12); color: var(--obj-color); }
        .tbadge-arr { background: rgba(56,189,248,0.12); color: var(--mod-color); }
        .tbadge-hash { background: rgba(56,189,248,0.12); color: var(--mod-color); }

        .str-input, .str-textarea {
            width: 100%;
            background: rgba(255,209,102,0.06);
            border: 1px solid rgba(255,209,102,0.2);
            border-radius: 6px;
            color: var(--str-color);
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            padding: 5px 10px;
            transition: all 0.2s;
        }
        .str-input:focus, .str-textarea:focus {
            outline: none;
            border-color: var(--str-color);
            box-shadow: 0 0 0 3px rgba(255,209,102,0.1);
            background: rgba(255,209,102,0.1);
        }
        .str-textarea { min-height: 60px; resize: vertical; }

        .str-row {
            display: flex;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 8px;
            transition: background 0.15s;
            align-items: flex-start;
        }
        .str-row:hover { background: var(--surface2); }
        .str-path {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--text-dim);
            min-width: 200px;
            max-width: 300px;
            word-break: break-all;
            line-height: 1.5;
            padding-top: 5px;
            flex-shrink: 0;
        }
        .str-field { flex: 1; min-width: 0; }

        .toast {
            padding: 12px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            animation: toastIn 0.3s ease, toastOut 0.3s ease 2.7s forwards;
            pointer-events: none;
            max-width: 360px;
        }
        .toast-ok { background: rgba(0,232,150,0.15); color: var(--accent); border: 1px solid rgba(0,232,150,0.3); }
        .toast-err { background: rgba(255,80,80,0.15); color: #ff6b6b; border: 1px solid rgba(255,80,80,0.3); }
        .toast-info { background: rgba(110,198,255,0.15); color: #6ec6ff; border: 1px solid rgba(110,198,255,0.3); }
        @keyframes toastIn { from { opacity:0; transform:translateX(40px); } to { opacity:1; transform:translateX(0); } }
        @keyframes toastOut { from { opacity:1; } to { opacity:0; transform:translateY(-10px); } }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Space Grotesk', sans-serif;
        }
        .btn-accent { background: var(--accent); color: #070b09; }
        .btn-accent:hover { background: #33ffb5; box-shadow: 0 0 20px var(--accent-glow); transform: translateY(-1px); }
        .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
        .btn-ghost:hover { border-color: var(--border-hi); background: var(--surface); }
        .btn-ghost.active { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }

        .progress-bar { height: 4px; background: var(--surface2); border-radius: 2px; overflow: hidden; }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), #33ffb5);
            border-radius: 2px;
            transition: width 0.4s ease;
        }
        .big-arr-msg { font-size: 12px; color: var(--text-dim); padding: 6px 12px; font-style: italic; }

        @media (max-width: 640px) {
            .str-row { flex-direction: column; gap: 4px; }
            .str-path { min-width: auto; max-width: none; font-size: 10px; }
            .node-children { padding-left: 12px; margin-left: 10px; }
        }
        body::before {
            content: '';
            position: fixed;
            top: -200px; right: -200px;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(0,232,150,0.04), transparent 60%);
            pointer-events: none; z-index: 0;
        }
        body::after {
            content: '';
            position: fixed;
            bottom: -300px; left: -200px;
            width: 700px; height: 700px;
            background: radial-gradient(circle, rgba(255,209,102,0.03), transparent 60%);
            pointer-events: none; z-index: 0;
        }
        main { position: relative; z-index: 1; }
    </style>
</head>
<body>

<div id="toasts" class="fixed top-4 right-4 z-50 flex flex-col gap-2"></div>

<header class="border-b px-6 py-5" style="border-color:var(--border);background:var(--surface);">
    <div class="max-w-6xl mx-auto flex items-center justify-between flex-wrap gap-3">
        <div>
            <h1 class="text-xl font-bold tracking-tight" style="color:var(--accent);">
                <i class="fa-solid fa-file-code mr-2 text-base"></i>RVData2 Editor
            </h1>
            <p class="text-sm mt-1" style="color:var(--text-dim);">Translation tool untuk RPG Maker VX Ace — baca, edit, export .rvdata2</p>
        </div>
        <div class="mono text-xs px-3 py-1.5 rounded-lg" style="background:var(--surface2);color:var(--text-dim);border:1px solid var(--border);">
            Ruby Marshal 4.8
        </div>
    </div>
</header>

<main class="max-w-6xl mx-auto px-4 py-6 flex flex-col gap-5">

    <div id="uploadZone" class="p-10 text-center" onclick="document.getElementById('fileInput').click()">
        <input type="file" id="fileInput" accept=".rvdata2,.rvdata" class="hidden">
        <div class="relative z-10">
            <i class="fa-solid fa-cloud-arrow-up text-4xl mb-4" style="color:var(--accent);"></i>
            <p class="text-lg font-semibold mb-1">Drag & drop file .rvdata2 di sini</p>
            <p class="text-sm" style="color:var(--text-dim);">atau klik untuk pilih file — Map, System, CommonEvents, Actors, dll.</p>
        </div>
    </div>

    <div id="fileInfo" class="hidden rounded-xl p-4 flex flex-wrap gap-x-6 gap-y-2 items-center text-sm" style="background:var(--surface);border:1px solid var(--border);">
        <div><i class="fa-solid fa-file mr-2" style="color:var(--accent);"></i><span id="infoName" class="mono font-medium"></span></div>
        <div style="color:var(--text-dim);"><i class="fa-solid fa-weight-hanging mr-1"></i><span id="infoSize"></span></div>
        <div><span class="tbadge tbadge-obj" id="infoType"></span></div>
        <div style="color:var(--text-dim);"><i class="fa-solid fa-font mr-1"></i><span id="infoStrings">0</span> string ditemukan</div>
        <button class="btn btn-ghost text-xs ml-auto" onclick="resetAll()"><i class="fa-solid fa-rotate-left"></i> Reset</button>
    </div>

    <div id="toolbar" class="hidden flex flex-wrap gap-3 items-center">
        <div class="relative flex-1 min-w-[200px] max-w-md">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs" style="color:var(--text-dim);"></i>
            <input type="text" id="searchInput" placeholder="Cari string atau key..."
                class="w-full pl-9 pr-4 py-2 rounded-lg text-sm mono"
                style="background:var(--surface);border:1px solid var(--border);color:var(--text);outline:none;"
                onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">
        </div>
        <button class="btn btn-ghost text-xs active" id="btnTreeView" onclick="switchView('tree')">
            <i class="fa-solid fa-sitemap"></i> Tree
        </button>
        <button class="btn btn-ghost text-xs" id="btnStringsView" onclick="switchView('strings')">
            <i class="fa-solid fa-language"></i> Strings Only
        </button>
        <button class="btn btn-ghost text-xs" onclick="expandAll()" title="Expand semua"><i class="fa-solid fa-angles-down"></i></button>
        <button class="btn btn-ghost text-xs" onclick="collapseAll()" title="Collapse semua"><i class="fa-solid fa-angles-up"></i></button>
    </div>

    <div id="progressWrap" class="hidden">
        <div class="flex justify-between text-xs mb-1" style="color:var(--text-dim);">
            <span>Progress Terjemahan</span>
            <span id="progressText">0 / 0</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
    </div>

    <div id="treeContainer" class="hidden rounded-xl overflow-auto" style="background:var(--surface);border:1px solid var(--border);max-height:70vh;padding:8px;"></div>
    <div id="stringsContainer" class="hidden rounded-xl overflow-auto flex flex-col gap-1" style="background:var(--surface);border:1px solid var(--border);max-height:70vh;padding:8px;"></div>

    <div id="exportBar" class="hidden flex flex-wrap gap-3 items-center justify-center py-3">
        <button class="btn btn-accent" onclick="exportRvdata2()"><i class="fa-solid fa-download"></i> Export .rvdata2</button>
        <button class="btn btn-ghost" onclick="exportJSON()"><i class="fa-solid fa-file-code"></i> Export JSON</button>
    </div>

</main>
<script>
class MarshalParser {
    constructor(buffer) {
        this.buf = new Uint8Array(buffer);
        this.pos = 0;
        this.objects = [];
    }

    rb() {
        if (this.pos >= this.buf.length) throw new Error('Data habis tak terduga di posisi ' + this.pos);
        return this.buf[this.pos++];
    }

    rbs(n) {
        var slice = this.buf.slice(this.pos, this.pos + n);
        this.pos += n;
        return slice;
    }

    rl() {
        var bytes = [];
        while (this.pos < this.buf.length) {
            var b = this.rb();
            if (b === 0x0A) break;
            bytes.push(b);
        }
        return new TextDecoder('ascii').decode(new Uint8Array(bytes));
    }

    decodeStr(bytes) {
        try { return new TextDecoder('utf-8', { fatal: true }).decode(bytes); }
        catch (_) {
            try { return new TextDecoder('shift-jis', { fatal: true }).decode(bytes); }
            catch (_2) { return new TextDecoder('utf-8', { fatal: false }).decode(bytes); }
        }
    }

    parse() {
        var major = this.rb();
        var minor = this.rb();
        if (major !== 4 || minor !== 8) {
            console.warn('Versi Marshal ' + major + '.' + minor + ', bukan 4.8 standar');
        }
        return this.parseValue();
    }

    parseValue() {
        var t = String.fromCharCode(this.rb());
        switch (t) {
            case 'i': return this.pInt();
            case '"': return this.pStr();
            case ':': return this.pSym();
            case 'T': return { t: 'bool', v: true };
            case 'F': return { t: 'bool', v: false };
            case 'n': return { t: 'nil' };
            case '[': return this.pArr();
            case '{': return this.pHash();
            case 'o': return this.pOldObj();
            case 'I': return this.pInstance();
            case 'f': return this.pFloat();
            case ';': case '@': return this.pLink();
            case 'S': return this.pStruct();
            case 'C': return this.pClass();
            case 'M': return this.pModule();
            case 'e': return this.pExtended();
            case '/': return this.pRegexp();
            default:
                throw new Error("Tipe Marshal tidak dikenal: '" + t + "' (0x" + t.charCodeAt(0).toString(16) + ") di posisi " + (this.pos - 1));
        }
    }

    pInt() {
        return { t: 'int', v: parseInt(this.rl(), 10) };
    }

    pStr() {
        var len = parseInt(this.rl(), 10);
        var enc = null;
        if (this.pos < this.buf.length && this.buf[this.pos] === 0x3A) {
            this.rb();
            enc = parseInt(this.rl(), 10);
        }
        var bytes = this.rbs(len);
        var v = this.decodeStr(bytes);
        var result = { t: 'str', v: v, enc: enc, _orig: v };
        this.objects.push(result);
        return result;
    }

    pSym() {
        var bytes = [];
        while (this.pos < this.buf.length) {
            var b = this.rb();
            if (b === 0x0A) break;
            bytes.push(b);
        }
        var v = new TextDecoder('utf-8', { fatal: false }).decode(new Uint8Array(bytes));
        var result = { t: 'sym', v: v };
        this.objects.push(result);
        return result;
    }

    pFloat() {
        var line = this.rl().trim();
        var v;
        if (line === 'inf') v = Infinity;
        else if (line === '-inf') v = -Infinity;
        else if (line === 'nan') v = NaN;
        else v = parseFloat(line);
        return { t: 'float', v: v };
    }

    pArr() {
        var count = parseInt(this.rl(), 10);
        var items = [];
        var result = { t: 'arr', v: items };
        this.objects.push(result);
        for (var i = 0; i < count; i++) items.push(this.parseValue());
        if (this.pos < this.buf.length && this.buf[this.pos] === 0x5D) this.rb();
        return result;
    }

    pHash() {
        var count = parseInt(this.rl(), 10);
        var pairs = [];
        var result = { t: 'hash', v: pairs };
        this.objects.push(result);
        for (var i = 0; i < count; i++) {
            var k = this.parseValue();
            var val = this.parseValue();
            pairs.push([k, val]);
        }
        if (this.pos < this.buf.length && this.buf[this.pos] === 0x7D) this.rb();
        return result;
    }

    pOldObj() {
        var cls = this.pSym();
        var numIvars = parseInt(this.rl(), 10);
        var ivars = [];
        for (var i = 0; i < numIvars; i++) {
            var sym = this.pSym();
            var val = this.parseValue();
            ivars.push([sym.v, val]);
        }
        var result = { t: 'obj', cls: cls.v, ivars: ivars };
        this.objects.push(result);
        return result;
    }

    pInstance() {
        var cls = this.pSym();
        var hashNode = this.parseValue();
        var ivars = [];
        if (hashNode.t === 'hash') {
            for (var i = 0; i < hashNode.v.length; i++) {
                ivars.push([hashNode.v[i][0].v, hashNode.v[i][1]]);
            }
        }
        var result = { t: 'obj', cls: cls.v, ivars: ivars };
        this.objects[this.objects.length - 1] = result;
        return result;
    }

    pLink() {
        var idx = parseInt(this.rl(), 10);
        if (idx >= 0 && idx < this.objects.length) return this.objects[idx];
        throw new Error('Link objek tidak valid: index ' + idx);
    }

    pStruct() {
        var cls = this.pSym();
        var hashNode = this.parseValue();
        var ivars = [];
        if (hashNode.t === 'hash') {
            for (var i = 0; i < hashNode.v.length; i++) {
                ivars.push([hashNode.v[i][0].v, hashNode.v[i][1]]);
            }
        }
        var result = { t: 'obj', cls: cls.v, ivars: ivars };
        this.objects[this.objects.length - 1] = result;
        return result;
    }

    pClass() {
        var name = this.pSym();
        var result = { t: 'class', v: name.v };
        this.objects.push(result);
        return result;
    }

    pModule() {
        var name = this.pSym();
        var result = { t: 'module', v: name.v };
        this.objects.push(result);
        return result;
    }

    pExtended() {
        this.pSym();
        return this.parseValue();
    }

    pRegexp() {
        var str = this.pStr();
        var opts = this.parseValue();
        return { t: 'regexp', v: str.v, opts: opts };
    }
}
class MarshalWriter {
    constructor() {
        this.bytes = [];
    }

    wb(b) { this.bytes.push(b & 0xFF); }

    wl(str) {
        for (var i = 0; i < str.length; i++) this.wb(str.charCodeAt(i));
        this.wb(0x0A);
    }

    wbytes(arr) { for (var i = 0; i < arr.length; i++) this.wb(arr[i]); }

    serialize(node) {
        this.wb(4); this.wb(8);
        this.writeVal(node);
        return new Uint8Array(this.bytes);
    }

    writeVal(node) {
        if (!node || node.t === 'nil') { this.wb(0x6E); return; }
        switch (node.t) {
            case 'str': this.wStr(node); break;
            case 'sym': this.wSym(node.v); break;
            case 'int': this.wb(0x69); this.wl(String(node.v)); break;
            case 'float': this.wFloat(node.v); break;
            case 'bool': this.wb(node.v ? 0x54 : 0x46); break;
            case 'arr': this.wArr(node.v); break;
            case 'hash': this.wHash(node.v); break;
            case 'obj': this.wObj(node); break;
            case 'class': this.wb(0x43); this.wSym(node.v); break;
            case 'module': this.wb(0x4D); this.wSym(node.v); break;
            default:
                console.warn('Tipe tidak dikenal saat serialize:', node.t);
                this.wb(0x6E);
        }
    }

    wStr(node) {
        this.wb(0x22);
        var encoded = new TextEncoder().encode(node.v);
        this.wl(String(encoded.length));
        if (node.enc !== null && node.enc !== undefined) {
            this.wb(0x3A);
            this.wl(String(node.enc));
        }
        this.wbytes(encoded);
    }

    wSym(name) {
        this.wb(0x3A);
        this.wbytes(new TextEncoder().encode(name));
        this.wb(0x0A);
    }

    wFloat(v) {
        this.wb(0x66);
        var s;
        if (v === Infinity) s = 'inf';
        else if (v === -Infinity) s = '-inf';
        else if (Number.isNaN(v)) s = 'nan';
        else s = String(v);
        this.wl(s);
    }

    wArr(arr) {
        this.wb(0x5B);
        this.wl(String(arr.length));
        for (var i = 0; i < arr.length; i++) this.writeVal(arr[i]);
        this.wb(0x5D);
    }

    wHash(pairs) {
        this.wb(0x7B);
        this.wl(String(pairs.length));
        for (var i = 0; i < pairs.length; i++) {
            this.writeVal(pairs[i][0]);
            this.writeVal(pairs[i][1]);
        }
        this.wb(0x7D);
    }

    wObj(node) {
        this.wb(0x49);
        this.wSym(node.cls);
        this.wb(0x7B);
        this.wl(String(node.ivars.length));
        for (var i = 0; i < node.ivars.length; i++) {
            this.wSym(node.ivars[i][0]);
            this.writeVal(node.ivars[i][1]);
        }
        this.wb(0x7D);
    }
}
var parsedData = null;
var originalBuffer = null;
var fileName = '';
var currentView = 'tree';
var allStrings = [];

function showToast(msg, type) {
    type = type || 'info';
    var el = document.createElement('div');
    el.className = 'toast toast-' + type;
    el.textContent = msg;
    document.getElementById('toasts').appendChild(el);
    setTimeout(function() { el.remove(); }, 3100);
}

function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(2) + ' MB';
}

function isBinaryStr(s) {
    if (!s || s.length === 0) return false;
    var np = 0;
    var lim = Math.min(s.length, 100);
    for (var i = 0; i < lim; i++) {
        var c = s.charCodeAt(i);
        if (c < 32 && c !== 9 && c !== 10 && c !== 13) np++;
    }
    return (np / lim) > 0.3;
}

function escHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function detectFileType(node) {
    if (node.t === 'obj') return node.cls;
    if (node.t === 'hash') return 'Hash (Data)';
    if (node.t === 'arr') return 'Array';
    return node.t || '?';
}

function collectStrings(node, path, result) {
    if (!node || typeof node !== 'object') return;
    if (node.t === 'str' && !isBinaryStr(node.v)) {
        result.push({ node: node, path: path });
        return;
    }
    if (node.t === 'obj') {
        for (var i = 0; i < node.ivars.length; i++) {
            collectStrings(node.ivars[i][1], path + ' \u2192 ' + node.ivars[i][0], result);
        }
    } else if (node.t === 'arr') {
        for (var i = 0; i < node.v.length; i++) {
            collectStrings(node.v[i], path + ' \u2192 [' + i + ']', result);
        }
    } else if (node.t === 'hash') {
        for (var i = 0; i < node.v.length; i++) {
            var k = node.v[i][0];
            var keyLabel = k.t === 'sym' ? k.v : (k.t === 'int' ? '[' + k.v + ']' : String(k.v || '?'));
            collectStrings(node.v[i][1], path + ' \u2192 ' + keyLabel, result);
        }
    }
}

function renderTree(node, container, depth) {
    if (!node || typeof node !== 'object') return;
    if (node.t === 'nil') { container.appendChild(makeLeaf('nil', 'nil', 'nil', depth)); return; }
    if (node.t === 'bool') { container.appendChild(makeLeaf('bool', String(node.v), 'bool', depth)); return; }
    if (node.t === 'int') { container.appendChild(makeLeaf('int', String(node.v), 'int', depth)); return; }
    if (node.t === 'float') { container.appendChild(makeLeaf('float', String(node.v), 'float', depth)); return; }
    if (node.t === 'sym') { container.appendChild(makeLeaf('sym', ':' + node.v, 'sym', depth)); return; }
    if (node.t === 'class' || node.t === 'module') { container.appendChild(makeLeaf(node.t, node.v, node.t, depth)); return; }

    if (node.t === 'str') {
        if (isBinaryStr(node.v)) {
            container.appendChild(makeLeaf('str', '[Binary: ' + node.v.length + ' chars]', 'str', depth));
        } else {
            container.appendChild(makeStrLeaf(node, depth));
        }
        return;
    }

    if (node.t === 'arr') {
        var el = makeContainer('arr', 'Array [' + node.v.length + ']', 'arr', depth);
        var childDiv = el.querySelector('.node-children');
        var isBig = node.v.length > 300;
        if (isBig) {
            var msg = document.createElement('div');
            msg.className = 'big-arr-msg';
            msg.textContent = node.v.length + ' elemen \u2014 terlalu besar, tidak di-expand.';
            childDiv.appendChild(msg);
        } else {
            for (var i = 0; i < node.v.length; i++) renderTree(node.v[i], childDiv, depth + 1);
        }
        if (depth > 1 || isBig) el.querySelector('.toggle-icon').classList.add('collapsed');
        else childDiv.classList.add('expanded');
        container.appendChild(el);
        return;
    }

    if (node.t === 'hash') {
        var el = makeContainer('hash', 'Hash {' + node.v.length + '}', 'hash', depth);
        var childDiv = el.querySelector('.node-children');
        for (var i = 0; i < node.v.length; i++) {
            var k = node.v[i][0];
            var keyLabel = k.t === 'sym' ? k.v : (k.t === 'int' ? '[' + k.v + ']' : String(k.v || '?'));
            var wrapper = document.createElement('div');
            wrapper.className = 'tree-node';
            var keyHeader = document.createElement('div');
            keyHeader.className = 'node-header';
            keyHeader.innerHTML = '<span style="width:18px;"></span><span class="node-key" style="color:var(--sym-color);font-weight:600;">' + escHtml(keyLabel) + '</span><span style="color:var(--text-dim);font-size:11px;">\u2192</span>';
            wrapper.appendChild(keyHeader);
            var valContainer = document.createElement('div');
            valContainer.className = 'node-children expanded';
            renderTree(node.v[i][1], valContainer, depth + 1);
            wrapper.appendChild(valContainer);
            childDiv.appendChild(wrapper);
        }
        if (depth > 1) el.querySelector('.toggle-icon').classList.add('collapsed');
        else childDiv.classList.add('expanded');
        container.appendChild(el);
        return;
    }

    if (node.t === 'obj') {
        var el = makeContainer('obj', node.cls, 'obj', depth);
        var childDiv = el.querySelector('.node-children');
        for (var i = 0; i < node.ivars.length; i++) {
            var symName = node.ivars[i][0];
            var wrapper = document.createElement('div');
            wrapper.className = 'tree-node';
            var keyHeader = document.createElement('div');
            keyHeader.className = 'node-header';
            keyHeader.innerHTML = '<span style="width:18px;"></span><span class="node-key">' + escHtml(symName) + '</span>';
            wrapper.appendChild(keyHeader);
            var valContainer = document.createElement('div');
            valContainer.className = 'node-children expanded';
            renderTree(node.ivars[i][1], valContainer, depth + 1);
            wrapper.appendChild(valContainer);
            childDiv.appendChild(wrapper);
        }
        if (depth > 0) el.querySelector('.toggle-icon').classList.add('collapsed');
        else childDiv.classList.add('expanded');
        container.appendChild(el);
        return;
    }
}

function makeLeaf(type, displayVal, badgeType, depth) {
    var el = document.createElement('div');
    el.className = 'tree-node';
    var colorMap = { str: 'var(--str-color)', int: 'var(--num-color)', float: 'var(--num-color)', bool: 'var(--bool-color)', nil: 'var(--nil-color)', sym: 'var(--sym-color)' };
    var color = colorMap[type] || 'var(--text)';
    el.innerHTML = '<div class="node-header" style="padding-left:' + (depth * 20 + 8) + 'px;">'
        + '<span style="width:18px;"></span>'
        + '<span class="tbadge tbadge-' + badgeType + '">' + type + '</span>'
        + '<span class="mono text-sm" style="color:' + color + ';word-break:break-all;">' + escHtml(displayVal || '') + '</span>'
        + '</div>';
    return el;
}

function makeStrLeaf(node, depth) {
    var el = document.createElement('div');
    el.className = 'tree-node';
    var isMulti = node.v.indexOf('\n') !== -1 || node.v.length > 60;
    var modified = node._orig !== undefined && node.v !== node._orig;
    var html = '<div class="node-header" style="padding-left:' + (depth * 20 + 8) + 'px;">'
        + '<span style="width:18px;"></span>'
        + '<span class="tbadge tbadge-str">str</span>';
    if (modified) html += '<span style="color:var(--accent);font-size:10px;"><i class="fa-solid fa-pen"></i></span>';
    html += '</div>'
        + '<div style="padding-left:' + (depth * 20 + 30) + 'px;padding-right:8px;padding-bottom:6px;">'
        + (isMulti
            ? '<textarea class="str-textarea" rows="2">' + escHtml(node.v) + '</textarea>'
            : '<input type="text" class="str-input" value="' + escHtml(node.v) + '">')
        + '</div>';
    el.innerHTML = html;

    var input = el.querySelector('.str-input, .str-textarea');
    input._node = node;
    input.addEventListener('input', function() {
        this._node.v = this.value;
        updateProgress();
        var header = this.closest('.tree-node').querySelector('.node-header');
        if (this._node._orig !== undefined && this._node.v !== this._node._orig) {
            if (!header.querySelector('.fa-pen')) {
                var icon = document.createElement('span');
                icon.style.cssText = 'color:var(--accent);font-size:10px;';
                icon.innerHTML = '<i class="fa-solid fa-pen"></i>';
                header.appendChild(icon);
            }
        } else {
            var pen = header.querySelector('.fa-pen');
            if (pen) pen.parentElement.remove();
        }
    });
    return el;
}

function makeContainer(type, label, badgeType, depth) {
    var el = document.createElement('div');
    el.className = 'tree-node';
    el.innerHTML = '<div class="node-header has-children" style="padding-left:' + (depth * 20 + 8) + 'px;">'
        + '<span class="toggle-icon"><i class="fa-solid fa-caret-down"></i></span>'
        + '<span class="tbadge tbadge-' + badgeType + '">' + escHtml(label) + '</span>'
        + '</div>'
        + '<div class="node-children"></div>';
    return el;
}
function renderStringsView(filter) {
    var container = document.getElementById('stringsContainer');
    container.innerHTML = '';
    var term = (filter || '').toLowerCase();
    var count = 0;
    for (var i = 0; i < allStrings.length; i++) {
        var item = allStrings[i];
        var node = item.node;
        var path = item.path;
        if (term && path.toLowerCase().indexOf(term) === -1 && node.v.toLowerCase().indexOf(term) === -1) continue;

        var modified = node._orig !== undefined && node.v !== node._orig;
        var isMulti = node.v.indexOf('\n') !== -1 || node.v.length > 60;
        var row = document.createElement('div');
        row.className = 'str-row';
        var html = '<div class="str-path">' + escHtml(path) + '</div><div class="str-field">';
        if (modified) html += '<span style="color:var(--accent);font-size:10px;margin-right:4px;"><i class="fa-solid fa-pen"></i></span>';
        html += (isMulti
            ? '<textarea class="str-textarea" rows="2">' + escHtml(node.v) + '</textarea>'
            : '<input type="text" class="str-input" value="' + escHtml(node.v) + '">');
        html += '</div>';
        row.innerHTML = html;

        var input = row.querySelector('.str-input, .str-textarea');
        input._node = node;
        input.addEventListener('input', function() {
            this._node.v = this.value;
            updateProgress();
            var field = this.closest('.str-field');
            var pen = field.querySelector('.fa-pen');
            if (this._node._orig !== undefined && this._node.v !== this._node._orig) {
                if (!pen) {
                    var icon = document.createElement('span');
                    icon.style.cssText = 'color:var(--accent);font-size:10px;margin-right:4px;';
                    icon.innerHTML = '<i class="fa-solid fa-pen"></i>';
                    field.prepend(icon);
                }
            } else if (pen) {
                pen.parentElement.remove();
            }
        });
        container.appendChild(row);
        count++;
    }
    if (count === 0) {
        container.innerHTML = '<div class="text-center py-10" style="color:var(--text-dim);">Tidak ada string ditemukan' + (term ? ' untuk "' + escHtml(term) + '"' : '') + '</div>';
    }
}

function updateProgress() {
    var total = allStrings.length;
    var modified = 0;
    for (var i = 0; i < allStrings.length; i++) {
        if (allStrings[i].node._orig !== undefined && allStrings[i].node.v !== allStrings[i].node._orig) modified++;
    }
    document.getElementById('progressText').textContent = modified + ' / ' + total + ' diedit';
    var pct = total > 0 ? (modified / total * 100) : 0;
    document.getElementById('progressFill').style.width = pct + '%';
}

function switchView(view) {
    currentView = view;
    document.getElementById('btnTreeView').classList.toggle('active', view === 'tree');
    document.getElementById('btnStringsView').classList.toggle('active', view === 'strings');
    document.getElementById('treeContainer').classList.toggle('hidden', view !== 'tree');
    document.getElementById('stringsContainer').classList.toggle('hidden', view !== 'strings');
    if (view === 'strings') renderStringsView(document.getElementById('searchInput').value);
}

function expandAll() {
    var all = document.querySelectorAll('.node-children');
    for (var i = 0; i < all.length; i++) all[i].classList.add('expanded');
    var icons = document.querySelectorAll('.toggle-icon');
    for (var i = 0; i < icons.length; i++) icons[i].classList.remove('collapsed');
}

function collapseAll() {
    var all = document.querySelectorAll('.node-children');
    for (var i = 0; i < all.length; i++) all[i].classList.remove('expanded');
    var icons = document.querySelectorAll('.toggle-icon');
    for (var i = 0; i < icons.length; i++) icons[i].classList.add('collapsed');
}

function handleFile(file) {
    if (!file) return;
    fileName = file.name;
    var reader = new FileReader();
    reader.onload = function(e) {
        originalBuffer = e.target.result;
        try {
            var parser = new MarshalParser(originalBuffer);
            parsedData = parser.parse();
            allStrings = [];
            var rootLabel = parsedData.t === 'obj' ? parsedData.cls : (parsedData.t || 'root');
            collectStrings(parsedData, rootLabel, allStrings);
            document.getElementById('infoName').textContent = fileName;
            document.getElementById('infoSize').textContent = formatSize(file.size);
            document.getElementById('infoType').textContent = detectFileType(parsedData);
            document.getElementById('infoStrings').textContent = allStrings.length;
            document.getElementById('fileInfo').classList.remove('hidden');
            document.getElementById('toolbar').classList.remove('hidden');
            document.getElementById('progressWrap').classList.remove('hidden');
            document.getElementById('exportBar').classList.remove('hidden');
            document.getElementById('uploadZone').style.display = 'none';
            var tc = document.getElementById('treeContainer');
            tc.innerHTML = '';
            renderTree(parsedData, tc, 0);
            document.getElementById('stringsContainer').innerHTML = '';
            switchView('tree');
            updateProgress();
            showToast('Berhasil memuat ' + fileName + ' \u2014 ' + allStrings.length + ' string ditemukan', 'ok');
        } catch (err) {
            showToast('Gagal parse file: ' + err.message, 'err');
            console.error(err);
        }
    };
    reader.readAsArrayBuffer(file);
}

function resetAll() {
    if (!originalBuffer) return;
    try {
        var parser = new MarshalParser(originalBuffer);
        parsedData = parser.parse();
        allStrings = [];
        var rootLabel = parsedData.t === 'obj' ? parsedData.cls : 'root';
        collectStrings(parsedData, rootLabel, allStrings);
        var tc = document.getElementById('treeContainer');
        tc.innerHTML = '';
        renderTree(parsedData, tc, 0);
        document.getElementById('stringsContainer').innerHTML = '';
        if (currentView === 'strings') renderStringsView();
        updateProgress();
        showToast('Data di-reset ke awal', 'info');
    } catch (err) {
        showToast('Gagal reset: ' + err.message, 'err');
    }
}

function exportRvdata2() {
    if (!parsedData) return;
    try {
        var writer = new MarshalWriter();
        var data = writer.serialize(parsedData);
        var blob = new Blob([data], { type: 'application/octet-stream' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = fileName || 'output.rvdata2';
        a.click();
        URL.revokeObjectURL(url);
        showToast('File .rvdata2 berhasil di-export!', 'ok');
    } catch (err) {
        showToast('Gagal export: ' + err.message, 'err');
        console.error(err);
    }
}

function exportJSON() {
    if (!parsedData) return;
    try {
        function toJS(node) {
            if (!node || typeof node !== 'object') return node;
            if (node.t === 'str') return node.v;
            if (node.t === 'sym') return ':' + node.v;
            if (node.t === 'int' || node.t === 'float') return node.v;
            if (node.t === 'bool') return node.v;
            if (node.t === 'nil') return null;
            if (node.t === 'arr') return node.v.map(toJS);
            if (node.t === 'hash') {
                var obj = {};
                for (var i = 0; i < node.v.length; i++) {
                    var k = node.v[i][0];
                    var key = k.t === 'sym' ? k.v : (k.t === 'int' ? String(k.v) : String(k.v || ''));
                    obj[key] = toJS(node.v[i][1]);
                }
                return obj;
            }
            if (node.t === 'obj') {
                var obj = { __class: node.cls };
                for (var i = 0; i < node.ivars.length; i++) {
                    obj[node.ivars[i][0]] = toJS(node.ivars[i][1]);
                }
                return obj;
            }
            return node;
        }
        var jsObj = toJS(parsedData);
        var json = JSON.stringify(jsObj, null, 2);
        var blob = new Blob([json], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = (fileName || 'output').replace(/\.\w+$/, '') + '.json';
        a.click();
        URL.revokeObjectURL(url);
        showToast('File JSON berhasil di-export!', 'ok');
    } catch (err) {
        showToast('Gagal export JSON: ' + err.message, 'err');
    }
}

function filterTree(term) {
    var allHeaders = document.querySelectorAll('#treeContainer .node-header');
    if (!term) {
        for (var i = 0; i < allHeaders.length; i++) allHeaders[i].closest('.tree-node').style.display = '';
        return;
    }
    var matchSet = new Set();
    for (var i = 0; i < allHeaders.length; i++) {
        var text = allHeaders[i].textContent.toLowerCase();
        if (text.indexOf(term) !== -1) {
            var el = allHeaders[i].closest('.tree-node');
            while (el) {
                matchSet.add(el);
                var parentChildren = el.parentElement;
                if (parentChildren && parentChildren.classList.contains('node-children')) {
                    parentChildren.classList.add('expanded');
                    var prevHeader = parentChildren.previousElementSibling;
                    if (prevHeader) {
                        var t = prevHeader.querySelector('.toggle-icon');
                        if (t) t.classList.remove('collapsed');
                    }
                }
                el = parentChildren ? parentChildren.closest('.tree-node') : null;
            }
        }
    }
    for (var i = 0; i < allHeaders.length; i++) {
        var node = allHeaders[i].closest('.tree-node');
        node.style.display = matchSet.has(node) ? '' : 'none';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    var uploadZone = document.getElementById('uploadZone');
    var fileInput = document.getElementById('fileInput');
    var searchInput = document.getElementById('searchInput');

    var dragEvts = ['dragenter', 'dragover'];
    for (var i = 0; i < dragEvts.length; i++) {
        uploadZone.addEventListener(dragEvts[i], function(e) {
            e.preventDefault(); e.stopPropagation();
            uploadZone.classList.add('dragover');
        });
    }
    var dropEvts = ['dragleave', 'drop'];
    for (var i = 0; i < dropEvts.length; i++) {
        uploadZone.addEventListener(dropEvts[i], function(e) {
            e.preventDefault(); e.stopPropagation();
            uploadZone.classList.remove('dragover');
        });
    }
    uploadZone.addEventListener('drop', function(e) {
        var files = e.dataTransfer.files;
        if (files.length > 0) handleFile(files[0]);
    });

    document.body.addEventListener('dragover', function(e) { e.preventDefault(); });
    document.body.addEventListener('drop', function(e) {
        e.preventDefault();
        var files = e.dataTransfer.files;
        if (files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', function() {
        if (fileInput.files.length > 0) handleFile(fileInput.files[0]);
    });

    var searchTimeout;
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
            if (currentView === 'strings') {
                renderStringsView(searchInput.value);
            } else {
                filterTree(searchInput.value.toLowerCase());
            }
        }, 200);
    });

    document.getElementById('treeContainer').addEventListener('click', function(e) {
        var header = e.target.closest('.node-header.has-children');
        if (!header) return;
        var nodeEl = header.closest('.tree-node');
        var children = nodeEl.querySelector(':scope > .node-children');
        var icon = header.querySelector('.toggle-icon');
        if (children) {
            children.classList.toggle('expanded');
            icon.classList.toggle('collapsed');
        }
    });

    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault(); exportRvdata2();
        }
        if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
            e.preventDefault(); searchInput.focus();
        }
    });
});
</script>
</body>
